{#
| Variable         | Type    | Description                     |
|------------------|---------|---------------------------------|
| cart             | object  |                                 |
| cart.items_count | int     |                                 |
| cart.total       | string  | Formatted total ex: "١٠٠ ر.س"   |
#}
{% set important_links = theme.settings.get('important_links') %}

{% set show_header_cats = theme.settings.get('header_categories_enabled', true) %}
{% set header_cats_pos_raw = theme.settings.get('header_categories_position', 'inside_nav') %}
{% set header_cats_pos = (header_cats_pos_raw is iterable) ? header_cats_pos_raw[0].value|default('inside_nav') : header_cats_pos_raw %}

{% set header_cats_style_raw = theme.settings.get('header_categories_style', 'marquee') %}
{% set header_cats_style = (header_cats_style_raw is iterable) ? header_cats_style_raw[0].value|default('marquee') : header_cats_style_raw %}

{% set header_cats_bg = theme.settings.get('header_categories_bg', '#061527') %}
{% set header_cats_text = theme.settings.get('header_categories_text_color', '#0f172a') %}
{% set header_cats_accent = theme.settings.get('header_categories_accent_color', '#f59e0b') %}

{% set default_cats = [
    {'name': 'سوناتا (Sonata)', 'url': '/products?keyword=سوناتا', 'icon': 'sicon-car-side'},
    {'name': 'إلنترا (Elantra)', 'url': '/products?keyword=النترا', 'icon': 'sicon-car-side'},
    {'name': 'أكسنت (Accent)', 'url': '/products?keyword=أكسنت', 'icon': 'sicon-car-side'},
    {'name': 'أزيرا (Azera)', 'url': '/products?keyword=أزيرا', 'icon': 'sicon-car-side'},
    {'name': 'توسان (Tucson)', 'url': '/products?keyword=توسان', 'icon': 'sicon-car-side'},
    {'name': 'سنتافي (Santa Fe)', 'url': '/products?keyword=سنتافي', 'icon': 'sicon-car-side'},
    {'name': 'أوبتيما / K5', 'url': '/products?keyword=أوبتيما', 'icon': 'sicon-car-side'},
    {'name': 'سبورتاج (Sportage)', 'url': '/products?keyword=سبورتاج', 'icon': 'sicon-car-side'},
    {'name': 'سيراتو / K3', 'url': '/products?keyword=سيراتو', 'icon': 'sicon-car-side'},
    {'name': 'كادينزا / K8', 'url': '/products?keyword=كادينزا', 'icon': 'sicon-car-side'},
    {'name': 'سورينتو (Sorento)', 'url': '/products?keyword=سورينتو', 'icon': 'sicon-car-side'},
    {'name': 'ريو (Rio)', 'url': '/products?keyword=ريو', 'icon': 'sicon-car-side'}
] %}

<header data-testid="store-header" class="store-header">
  {# Saudi National Day Top Announcement Bar #}
  {% set nd_topbar_enabled = theme.settings.get('dora_nd_topbar_enabled', true) %}
  {% set nd_topbar_text = theme.settings.get('dora_nd_topbar_text', '🇸🇦 عروض اليوم الوطني 96: خصومات حصرية على قطع غيار هيونداي وكيا (بنزين وديزل) + شحن سريع لكافة مناطق المملكة | نوفر القطع غير المدرجة بالطلب برقم الهيكل') %}
  {% set nd_wa_phone = store.contacts.whatsapp|default(store.contacts.phone|default('966500000000'))|replace({'+': '', ' ': '', '-': ''}) %}
  
  {% if nd_topbar_enabled %}
    <div id="dora-nd-top-banner" class="bg-gradient-to-r from-emerald-950 via-emerald-900 to-slate-950 border-b border-emerald-500/30 text-white text-xs py-2 px-3 relative z-30 transition-all">
      <div class="container flex items-center justify-between gap-3">
        <div class="flex-1 flex items-center justify-center gap-2 text-center overflow-hidden">
          <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 font-extrabold text-[11px] shrink-0 border border-emerald-500/30">
            <span>🇸🇦 اليوم الوطني 96</span>
          </span>
          <span class="font-bold text-slate-100 truncate sm:text-clip">{{ nd_topbar_text }}</span>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <a
            href="https://wa.me/{{ nd_wa_phone }}?text={{ 'السلام عليكم، أرغب بطلب توفير قطعة غيار غير مدرجة لسيارة هيونداي/كيا برقم الهيكل لمتجر درة السيارة'|url_encode }}"
            target="_blank"
            rel="noopener noreferrer"
            class="hidden sm:inline-flex items-center gap-1 px-2.5 py-1 rounded bg-red-600 hover:bg-red-500 text-white font-black text-[11px] transition shadow"
          >
            <i class="sicon-whatsapp"></i>
            <span>طلب قطعة بالهيكل</span>
          </a>
          <button
            type="button"
            onclick="document.getElementById('dora-nd-top-banner').style.display='none'"
            class="text-slate-400 hover:text-white text-sm leading-none p-1 transition"
            aria-label="إغلاق الشريط"
          >
            &times;
          </button>
        </div>
      </div>
    </div>
  {% endif %}

  {# Bullet Delivery tag — mobile: own full-width row above the top nav #}
  <div class="lg:hidden">
    <salla-bullet-delivery-tag></salla-bullet-delivery-tag>
  </div>

  {# Top Nav #}
  <div class="top-navbar">
    <div class="container flex justify-between">
      <div class="flex-1 flex items-center gap-2">
          {# Footer Menu #}
          {% if important_links %}
            <salla-menu data-testid="store-header-topnav" source="footer" topnav></salla-menu>
          {% endif %}

          {# Language & Currency Component #}
          <div class="header-buttons">
              {% if store.settings.is_multilingual or store.settings.currencies_enabled %}
                  <salla-localization-modal data-testid="store-header-localization" show-trigger></salla-localization-modal>
              {% endif %}
          </div>

          {# Bullet Delivery tag — desktop only #}
          <div class="hidden lg:block">
            <salla-bullet-delivery-tag></salla-bullet-delivery-tag>
          </div>

          {# Scopes | Branches #}
          {% if store.scope %}
              <button class="btn--rounded-gray"
                      onclick="salla.event.dispatch('scopes::open', {'mode': 'default'})">
                  <i class="sicon-location rtl:ml-1 ltr:mr-1"></i> {{ store.scope.name }}
              </button>
          {% endif %}

          {# Search bar #}
          <div class="header-search flex-1">
            <salla-search data-testid="store-header-search" inline oval height="36"></salla-search>
          </div>
      </div>

      <salla-contacts data-testid="store-header-contacts" is-header></salla-contacts>
    </div>
  </div>

  {# Main Nav #}
  <div id="mainnav" class="main-nav-container shadow-default bg-white flex items-center">
      <div class="inner bg-inherit w-full">
          <div class="container">
              <div class="flex items-center justify-between relative w-full py-1.5 sm:py-2 gap-2 sm:gap-4">
                  
                  {# Right (RTL): Store Logo & Mobile Burger Menu #}
                  <div class="flex items-center shrink-0">
                      <a data-testid="store-header-mobile-toggle" class="lg:hidden mburger mburger--collapse leading-none rtl:ml-3 ltr:mr-3" href="#mobile-menu" aria-label="Open-menu">
                        <i class="sicon-menu text-primary text-2xl"></i>
                      </a>
                      <a data-testid="store-header-logo" class="navbar-brand shrink-0" href="{{ store.url }}">
                          <img fetchpriority="high" width="100%" height="100%" loading="eager" src="{{ store.logo|cdn(175) }}" alt="{{ store.name }} logo" class="max-h-11 sm:max-h-12 w-auto object-contain">
                          {% if is_page('index') %}
                            <h1 class="sr-only">{{ store.name }}</h1>
                          {% else %}
                            <h2 class="sr-only">{{ store.name }}</h2>
                          {% endif %}
                      </a>
                  </div>

                  {# Center: Header Categories (Desktop View) #}
                  {% if show_header_cats and header_cats_pos == 'inside_nav' %}
                      <div class="hidden lg:flex flex-1 mx-2 sm:mx-4 min-w-0 items-center justify-center overflow-hidden">
                          {% if header_cats_style == 'marquee' %}
                              <div class="header-cats-viewport py-1 max-w-full">
                                  <div class="header-cats-track" id="header-cats-nav-track-el">
                                      {% for i in 1..2 %}
                                          {% if categories and categories|length > 0 %}
                                              {% for cat in categories %}
                                                  {% set cat_img = cat.image.url|default(cat.image)|default(cat.icon.url)|default(cat.icon)|default(cat.avatar) %}
                                                  <a href="{{ cat.url }}" class="group flex flex-col items-center justify-center py-0.5 px-3 shrink-0 text-center cursor-pointer no-underline transition hover:-translate-y-0.5">
                                                      <div class="h-8 sm:h-9 w-auto min-w-[32px] max-w-[48px] flex items-center justify-center mb-0.5 group-hover:scale-115 transition-transform duration-300">
                                                          {% if cat_img %}
                                                              <img src="{{ cat_img }}" alt="{{ cat.name }}" class="max-h-full max-w-full object-contain drop-shadow" loading="lazy" />
                                                          {% else %}
                                                              <i class="sicon-car-side text-lg sm:text-xl transition" style="color: {{ header_cats_accent }};"></i>
                                                          {% endif %}
                                                      </div>
                                                      <span class="text-[10px] sm:text-[11px] font-bold whitespace-nowrap transition-colors duration-200" style="color: {{ header_cats_text }};">
                                                          {{ cat.name }}
                                                      </span>
                                                  </a>
                                              {% endfor %}
                                          {% else %}
                                              {% for cat in default_cats %}
                                                  <a href="{{ cat.url }}" class="group flex flex-col items-center justify-center py-0.5 px-3 shrink-0 text-center cursor-pointer no-underline transition hover:-translate-y-0.5">
                                                      <div class="h-8 sm:h-9 w-auto min-w-[32px] max-w-[48px] flex items-center justify-center mb-0.5 group-hover:scale-115 transition-transform duration-300">
                                                          <i class="{{ cat.icon }} text-lg sm:text-xl transition" style="color: {{ header_cats_accent }};"></i>
                                                      </div>
                                                      <span class="text-[10px] sm:text-[11px] font-bold whitespace-nowrap transition-colors duration-200" style="color: {{ header_cats_text }};">
                                                          {{ cat.name }}
                                                      </span>
                                                  </a>
                                              {% endfor %}
                                          {% endif %}
                                      {% endfor %}
                                  </div>
                              </div>
                          {% else %}
                              <div class="flex items-center gap-4 sm:gap-6 overflow-x-auto no-scrollbar py-1 px-1 scroll-smooth justify-center max-w-full" id="header-cats-nav-scroll-el">
                                  {% if categories and categories|length > 0 %}
                                      {% for cat in categories %}
                                          {% set cat_img = cat.image.url|default(cat.image)|default(cat.icon.url)|default(cat.icon)|default(cat.avatar) %}
                                          <a href="{{ cat.url }}" class="group flex flex-col items-center justify-center py-0.5 px-2.5 shrink-0 text-center cursor-pointer no-underline transition hover:-translate-y-0.5">
                                              <div class="h-8 sm:h-9 w-auto min-w-[32px] max-w-[48px] flex items-center justify-center mb-0.5 group-hover:scale-115 transition-transform duration-300">
                                                  {% if cat_img %}
                                                      <img src="{{ cat_img }}" alt="{{ cat.name }}" class="max-h-full max-w-full object-contain drop-shadow" loading="lazy" />
                                                  {% else %}
                                                      <i class="sicon-car-side text-lg sm:text-xl transition" style="color: {{ header_cats_accent }};"></i>
                                                  {% endif %}
                                              </div>
                                              <span class="text-[10px] sm:text-[11px] font-bold whitespace-nowrap transition-colors duration-200" style="color: {{ header_cats_text }};">
                                                  {{ cat.name }}
                                              </span>
                                          </a>
                                      {% endfor %}
                                  {% else %}
                                      {% for cat in default_cats %}
                                          <a href="{{ cat.url }}" class="group flex flex-col items-center justify-center py-0.5 px-2.5 shrink-0 text-center cursor-pointer no-underline transition hover:-translate-y-0.5">
                                              <div class="h-8 sm:h-9 w-auto min-w-[32px] max-w-[48px] flex items-center justify-center mb-0.5 group-hover:scale-115 transition-transform duration-300">
                                                  <i class="{{ cat.icon }} text-lg sm:text-xl transition" style="color: {{ header_cats_accent }};"></i>
                                              </div>
                                              <span class="text-[10px] sm:text-[11px] font-bold whitespace-nowrap transition-colors duration-200" style="color: {{ header_cats_text }};">
                                                  {{ cat.name }}
                                              </span>
                                          </a>
                                      {% endfor %}
                                  {% endif %}
                              </div>
                          {% endif %}
                      </div>
                  {% else %}
                      <div class="hidden lg:flex flex-1 items-center justify-center">
                          <custom-main-menu></custom-main-menu>
                      </div>
                  {% endif %}

                  {# Left (RTL): User Profile & Cart #}
                  <div class="flex items-center justify-end shrink-0 my-1 gap-2">
                      <salla-user-menu data-testid="store-header-user-menu" avatar-only show-header show-trigger></salla-user-menu>
                      <salla-cart-summary data-testid="store-header-cart" class="ml-2 rtl:ml-[unset] rtl:mr-2">
                        <i slot="icon" class="header-btn__icon icon sicon-shopping-bag"></i>
                      </salla-cart-summary>
                  </div>

              </div>
          </div>
      </div>
  </div>

  {# ========================================================================= #}
  {# HEADER CATEGORIES BAR (Below Navbar Mode / Responsive Mobile Strip)       #}
  {# ========================================================================= #}
  {% if show_header_cats %}
    <div class="header-categories-bar relative overflow-hidden border-t border-b border-white/10 shadow-sm {{ header_cats_pos == 'inside_nav' ? 'block lg:hidden' : 'block' }}" style="background-color: {{ header_cats_bg }};">
        <div class="container mx-auto px-2 sm:px-4">
            {% if header_cats_style == 'marquee' %}
                <div class="header-cats-viewport py-2">
                    <div class="header-cats-track" id="header-cats-track-el">
                        {% for i in 1..2 %}
                            {% if categories and categories|length > 0 %}
                                {% for cat in categories %}
                                    {% set cat_img = cat.image.url|default(cat.image)|default(cat.icon.url)|default(cat.icon)|default(cat.avatar) %}
                                    <a href="{{ cat.url }}" class="group flex flex-col items-center justify-center py-1 px-3 shrink-0 text-center cursor-pointer no-underline transition hover:-translate-y-0.5">
                                        <div class="h-9 sm:h-10 w-auto min-w-[34px] max-w-[50px] flex items-center justify-center mb-1 group-hover:scale-115 transition-transform duration-300">
                                            {% if cat_img %}
                                                <img src="{{ cat_img }}" alt="{{ cat.name }}" class="max-h-full max-w-full object-contain drop-shadow" loading="lazy" />
                                            {% else %}
                                                <i class="sicon-car-side text-lg sm:text-xl transition" style="color: {{ header_cats_accent }};"></i>
                                            {% endif %}
                                        </div>
                                        <span class="text-[10.5px] sm:text-[11px] font-bold whitespace-nowrap transition-colors duration-200" style="color: #ffffff;">
                                            {{ cat.name }}
                                        </span>
                                    </a>
                                {% endfor %}
                            {% else %}
                                {% for cat in default_cats %}
                                    <a href="{{ cat.url }}" class="group flex flex-col items-center justify-center py-1 px-3 shrink-0 text-center cursor-pointer no-underline transition hover:-translate-y-0.5">
                                        <div class="h-9 sm:h-10 w-auto min-w-[34px] max-w-[50px] flex items-center justify-center mb-1 group-hover:scale-115 transition-transform duration-300">
                                            <i class="{{ cat.icon }} text-lg sm:text-xl transition" style="color: {{ header_cats_accent }};"></i>
                                        </div>
                                        <span class="text-[10.5px] sm:text-[11px] font-bold whitespace-nowrap transition-colors duration-200" style="color: #ffffff;">
                                            {{ cat.name }}
                                        </span>
                                    </a>
                                {% endfor %}
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
            {% else %}
                <div class="flex items-center gap-4 sm:gap-6 overflow-x-auto no-scrollbar py-2 px-1 scroll-smooth justify-start sm:justify-center" id="header-cats-scroll-el">
                    {% if categories and categories|length > 0 %}
                        {% for cat in categories %}
                            {% set cat_img = cat.image.url|default(cat.image)|default(cat.icon.url)|default(cat.icon)|default(cat.avatar) %}
                            <a href="{{ cat.url }}" class="group flex flex-col items-center justify-center py-1 px-3 shrink-0 text-center cursor-pointer no-underline transition hover:-translate-y-0.5">
                                <div class="h-9 sm:h-10 w-auto min-w-[34px] max-w-[50px] flex items-center justify-center mb-1 group-hover:scale-115 transition-transform duration-300">
                                    {% if cat_img %}
                                        <img src="{{ cat_img }}" alt="{{ cat.name }}" class="max-h-full max-w-full object-contain drop-shadow" loading="lazy" />
                                    {% else %}
                                        <i class="sicon-car-side text-lg sm:text-xl transition" style="color: {{ header_cats_accent }};"></i>
                                    {% endif %}
                                </div>
                                <span class="text-[10.5px] sm:text-[11px] font-bold whitespace-nowrap transition-colors duration-200" style="color: #ffffff;">
                                    {{ cat.name }}
                                </span>
                            </a>
                        {% endfor %}
                    {% else %}
                        {% for cat in default_cats %}
                            <a href="{{ cat.url }}" class="group flex flex-col items-center justify-center py-1 px-3 shrink-0 text-center cursor-pointer no-underline transition hover:-translate-y-0.5">
                                <div class="h-9 sm:h-10 w-auto min-w-[34px] max-w-[50px] flex items-center justify-center mb-1 group-hover:scale-115 transition-transform duration-300">
                                    <i class="{{ cat.icon }} text-lg sm:text-xl transition" style="color: {{ header_cats_accent }};"></i>
                                </div>
                                <span class="text-[10.5px] sm:text-[11px] font-bold whitespace-nowrap transition-colors duration-200" style="color: #ffffff;">
                                    {{ cat.name }}
                                </span>
                            </a>
                        {% endfor %}
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </div>
  {% endif %}

  {# Salla Store Categories Dynamic Live Sync Script #}
  {% if show_header_cats %}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof salla !== 'undefined' && salla.onReady) {
                salla.onReady().then(function() {
                    if (salla.api && salla.api.component && salla.api.component.getMenus) {
                        salla.api.component.getMenus().then(function(res) {
                            var menuData = (res && res.data) ? res.data : [];
                            if (menuData && menuData.length > 0) {
                                var navTrack = document.getElementById('header-cats-nav-track-el');
                                var navScroll = document.getElementById('header-cats-nav-scroll-el');
                                var track = document.getElementById('header-cats-track-el');
                                var scrollEl = document.getElementById('header-cats-scroll-el');
                                
                                var targets = [navTrack, navScroll, track, scrollEl].filter(Boolean);
                                if (!targets.length) return;

                                var htmlItems = '';
                                menuData.forEach(function(item) {
                                    var img = item.image || item.icon || item.avatar || '';
                                    var name = item.title || item.name || '';
                                    var url = item.url || '#';

                                    var iconHtml = img ? 
                                        '<img src="' + img + '" alt="' + name + '" class="max-h-full max-w-full object-contain drop-shadow" loading="lazy" />' :
                                        '<i class="sicon-car-side text-lg sm:text-xl" style="color: {{ header_cats_accent }};"></i>';

                                    htmlItems += '<a href="' + url + '" class="group flex flex-col items-center justify-center py-0.5 px-3 shrink-0 text-center cursor-pointer no-underline transition hover:-translate-y-0.5">' +
                                        '<div class="h-8 sm:h-9 w-auto min-w-[32px] max-w-[48px] flex items-center justify-center mb-0.5 group-hover:scale-115 transition-transform duration-300">' +
                                            iconHtml +
                                        '</div>' +
                                        '<span class="text-[10px] sm:text-[11px] font-bold whitespace-nowrap transition-colors duration-200" style="color: {{ header_cats_text }};">' +
                                            name +
                                        '</span>' +
                                    '</a>';
                                });

                                if (htmlItems) {
                                    targets.forEach(function(t) {
                                        if (t.classList.contains('header-cats-track')) {
                                            t.innerHTML = htmlItems + htmlItems;
                                        } else {
                                            t.innerHTML = htmlItems;
                                        }
                                    });
                                }
                            }
                        }).catch(function(e) {
                            console.warn('Salla header categories sync notice:', e);
                        });
                    }
                });
            }
        });
    </script>
  {% endif %}
</header>
