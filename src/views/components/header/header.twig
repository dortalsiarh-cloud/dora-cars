{#
| Variable         | Type    | Description                     |
|------------------|---------|---------------------------------|
| cart             | object  |                                 |
| cart.items_count | int     |                                 |
| cart.total       | string  | Formatted total ex: "١٠٠ ر.س"   |
#}
{% set important_links = theme.settings.get('important_links') %}

{% set show_header_cats = theme.settings.get('header_categories_enabled', true) %}
{% set header_cats_style_raw = theme.settings.get('header_categories_style', 'marquee') %}
{% set header_cats_style = (header_cats_style_raw is iterable) ? header_cats_style_raw[0].value|default('marquee') : header_cats_style_raw %}
{% set header_cats_bg = theme.settings.get('header_categories_bg', '#061527') %}
{% set header_cats_text = theme.settings.get('header_categories_text_color', '#e2e8f0') %}
{% set header_cats_accent = theme.settings.get('header_categories_accent_color', '#f59e0b') %}

<header data-testid="store-header" class="store-header">
  {# Bullet Delivery tag — mobile: own full-width row above the top nav
     (Figma "Mobile version"). Desktop keeps the inline pill below, next to
     scopes. Both instances self-gate on the same backend flag; `lg:hidden`
     matches the mobile/desktop split already used for the menu toggle below. #}
  <div class="lg:hidden">
    <salla-bullet-delivery-tag></salla-bullet-delivery-tag>
  </div>

  {# Top Nav #}
  <div class="top-navbar">
    <div class="container flex justify-between">
      <div class="flex-1 flex items-center gap-2">
          {# Footer Menu #}
          {% if important_links %}
            <salla-menu data-testid="store-header-topnav" source="footer" topnav></salla-menu>
          {% endif %}

          {# Language & Currency Component #}
          <div class="header-buttons">
              {% if store.settings.is_multilingual or store.settings.currencies_enabled %}
                  <salla-localization-modal data-testid="store-header-localization" show-trigger></salla-localization-modal>
              {% endif %}
          </div>

          {# Bullet Delivery tag — desktop only; mobile instance is above the top nav #}
          <div class="hidden lg:block">
            <salla-bullet-delivery-tag></salla-bullet-delivery-tag>
          </div>

          {# Scopes | Branches #}
          {% if store.scope %}
              <button class="btn--rounded-gray"
                      onclick="salla.event.dispatch('scopes::open', {'mode': 'default'})">
                  <i class="sicon-location rtl:ml-1 ltr:mr-1"></i> {{ store.scope.name }}
              </button>
          {% endif %}

          {# Search bar #}
          <div class="header-search flex-1">
            <salla-search data-testid="store-header-search" inline oval height="36"></salla-search>
          </div>
      </div>

      <salla-contacts data-testid="store-header-contacts" is-header></salla-contacts>
    </div>
  </div>

  {# Main Nav #}
  <div id="mainnav" class="main-nav-container shadow-default bg-white flex items-center">
      <div class="inner bg-inherit w-full">
          <div class="container">
              <div class="flex items-stretch justify-between relative">
                  <div class="flex items-center">
                      <a data-testid="store-header-mobile-toggle" class="lg:hidden mburger mburger--collapse leading-none rtl:ml-4 ltr:mr-4" href="#mobile-menu" aria-label="Open-menu">
                        <i class="sicon-menu text-primary text-2xl"></i>
                      </a>
                      <a data-testid="store-header-logo" class="navbar-brand" href="{{ store.url }}">
                          <img fetchpriority="high" width="100%" height="100%" loading="eager" src="{{ store.logo|cdn(175) }}" alt="{{ store.name }} logo">
                          {% if is_page('index') %}
                            <h1 class="sr-only">{{ store.name }}</h1>
                          {% else %}
                            <h2 class="sr-only">{{ store.name }}</h2>
                          {% endif %}
                      </a>
                      <custom-main-menu></custom-main-menu>
                  </div>
                  <div class="flex items-center justify-end my-2.5">
                      <salla-user-menu data-testid="store-header-user-menu" avatar-only show-header show-trigger></salla-user-menu>
                      <salla-cart-summary data-testid="store-header-cart" class="ml-4 rtl:ml-[unset] rtl:mr-4">
                        <i slot="icon" class="header-btn__icon icon sicon-shopping-bag"></i>
                      </salla-cart-summary>
                  </div>
              </div>
          </div>
      </div>
  </div>

  {# ========================================================================= #}
  {# HEADER CATEGORIES BAR (Icon on top + Name below & Infinite Ticker / Scroll) #}
  {# ========================================================================= #}
  {% if show_header_cats %}
    {% set default_cats = [
        {'name': 'الكمبروسر والتبريد', 'url': '/products?keyword=كمبروسر', 'icon': 'sicon-snowflake'},
        {'name': 'الفلاتر والزيوت', 'url': '/products?keyword=فلاتر', 'icon': 'sicon-drop'},
        {'name': 'الفرامل والمكابح', 'url': '/products?keyword=فرامل', 'icon': 'sicon-shield'},
        {'name': 'المساعدات والتعليق', 'url': '/products?keyword=مساعدات', 'icon': 'sicon-car-side'},
        {'name': 'الكهرباء والبواجي', 'url': '/products?keyword=بواجي', 'icon': 'sicon-flash'},
        {'name': 'السيور والشدادات', 'url': '/products?keyword=سيور', 'icon': 'sicon-settings'},
        {'name': 'الإنارة والاصطبات', 'url': '/products?keyword=انارة', 'icon': 'sicon-bulb'},
        {'name': 'قطع المحرك وجيربوكس', 'url': '/products?keyword=محرك', 'icon': 'sicon-wrench'}
    ] %}

    <div class="header-categories-bar relative overflow-hidden border-t border-b border-white/10" style="background-color: {{ header_cats_bg }};">
        <div class="container mx-auto px-2 sm:px-4">
            {% if header_cats_style == 'marquee' %}
                {# Continuous Seamless Ticker Marquee #}
                <div class="header-cats-viewport">
                    <div class="header-cats-track">
                        {% for i in 1..2 %}
                            {% if categories and categories|length > 0 %}
                                {% for cat in categories %}
                                    <a href="{{ cat.url }}" class="group flex flex-col items-center justify-center py-2 px-3 shrink-0 text-center cursor-pointer no-underline transition hover:-translate-y-0.5">
                                        <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-white/10 group-hover:bg-amber-400/20 border border-white/15 group-hover:border-amber-400/50 flex items-center justify-center mb-1 overflow-hidden transition-all duration-300 shadow-sm group-hover:scale-110">
                                            {% if cat.icon or cat.image %}
                                                <img src="{{ cat.icon|default(cat.image) }}" alt="{{ cat.name }}" class="w-5 h-5 sm:w-6 sm:h-6 object-contain drop-shadow" loading="lazy" />
                                            {% else %}
                                                <i class="sicon-car-side text-amber-400 text-base sm:text-lg group-hover:scale-110 transition"></i>
                                            {% endif %}
                                        </div>
                                        <span class="text-[10.5px] sm:text-[11px] font-bold whitespace-nowrap transition-colors" style="color: {{ header_cats_text }};">
                                            {{ cat.name }}
                                        </span>
                                    </a>
                                {% endfor %}
                            {% else %}
                                {% for cat in default_cats %}
                                    <a href="{{ cat.url }}" class="group flex flex-col items-center justify-center py-2 px-3 shrink-0 text-center cursor-pointer no-underline transition hover:-translate-y-0.5">
                                        <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-white/10 group-hover:bg-amber-400/20 border border-white/15 group-hover:border-amber-400/50 flex items-center justify-center mb-1 overflow-hidden transition-all duration-300 shadow-sm group-hover:scale-110">
                                            <i class="{{ cat.icon }} text-amber-400 text-base sm:text-lg group-hover:scale-110 transition"></i>
                                        </div>
                                        <span class="text-[10.5px] sm:text-[11px] font-bold whitespace-nowrap transition-colors" style="color: {{ header_cats_text }};">
                                            {{ cat.name }}
                                        </span>
                                    </a>
                                {% endfor %}
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
            {% else %}
                {# Horizontal Scroll Track with Smooth Touch #}
                <div class="flex items-center gap-3 sm:gap-4 overflow-x-auto no-scrollbar py-2 px-1 scroll-smooth justify-start sm:justify-center">
                    {% if categories and categories|length > 0 %}
                        {% for cat in categories %}
                            <a href="{{ cat.url }}" class="group flex flex-col items-center justify-center py-1.5 px-2.5 sm:px-3 shrink-0 text-center cursor-pointer no-underline transition hover:-translate-y-0.5">
                                <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-white/10 group-hover:bg-amber-400/20 border border-white/15 group-hover:border-amber-400/50 flex items-center justify-center mb-1 overflow-hidden transition-all duration-300 shadow-sm group-hover:scale-110">
                                    {% if cat.icon or cat.image %}
                                        <img src="{{ cat.icon|default(cat.image) }}" alt="{{ cat.name }}" class="w-5 h-5 sm:w-6 sm:h-6 object-contain drop-shadow" loading="lazy" />
                                    {% else %}
                                        <i class="sicon-car-side text-amber-400 text-base sm:text-lg group-hover:scale-110 transition"></i>
                                    {% endif %}
                                </div>
                                <span class="text-[10.5px] sm:text-[11px] font-bold whitespace-nowrap transition-colors" style="color: {{ header_cats_text }};">
                                    {{ cat.name }}
                                </span>
                            </a>
                        {% endfor %}
                    {% else %}
                        {% for cat in default_cats %}
                            <a href="{{ cat.url }}" class="group flex flex-col items-center justify-center py-1.5 px-2.5 sm:px-3 shrink-0 text-center cursor-pointer no-underline transition hover:-translate-y-0.5">
                                <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-white/10 group-hover:bg-amber-400/20 border border-white/15 group-hover:border-amber-400/50 flex items-center justify-center mb-1 overflow-hidden transition-all duration-300 shadow-sm group-hover:scale-110">
                                    <i class="{{ cat.icon }} text-amber-400 text-base sm:text-lg group-hover:scale-110 transition"></i>
                                </div>
                                <span class="text-[10.5px] sm:text-[11px] font-bold whitespace-nowrap transition-colors" style="color: {{ header_cats_text }};">
                                    {{ cat.name }}
                                </span>
                            </a>
                        {% endfor %}
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </div>
  {% endif %}
</header>
