{#
| Variable                           | Type     | Description                                                                  |
|------------------------------------|----------|------------------------------------------------------------------------------|
| component                          | object   | Contains merchant settings for fields from twilight.json `component` section |
| component.merge_with_top_component | bool     |                                                                              |
| component.title                    | ?string  |                                                                              |
| component.links                    | object[] | list of links                                                                |
| component.links[].icon             | string   |                                                                              |
| component.links[].image            | string   | PNG / Image URL                                                              |
| component.links[].title            | string   |                                                                              |
| component.links[].url              | string   |                                                                              |
| position                           | int      | Sorting number start from zero                                               |
#}

{% set main_links_id = 'main-links-' ~ position|default(random(100, 999)) %}

<section data-testid="store-home-main-links" class="s-block s-block--categories my-8 sm:my-12 {{ component.merge_with_top_component and position ? 'merge-with-top-component' : '' }} {{ not component.title and component.merge_with_top_component ? 'merged-has-no-title' : '' }}">
    <div class="container">
        <salla-slider  
            type="carousel"
            {% if component.title or component.merge_with_top_component %}
                block-title="{{ component.title|default('أقسام المتجر') }}"
            {% endif %}
            controls-outer
            show-controls="{{ component.show_controls ? 'true' : 'false' }}" 
            id="{{ main_links_id }}">
            <div slot="items">
                {% if component.show_cats %}
                    {# Automatic Categories Mode #}
                    {% for cat in component.categories %}
                        {% set cat_img = cat.image.url|default(cat.image) %}
                        <div class="swiper-slide slide--one-sixth">
                            <a href="{{ cat.url }}" class="slide--cat-entry group block text-center p-3.5 sm:p-4 rounded-2xl bg-white hover:bg-slate-900 border border-slate-200/85 hover:border-slate-800 shadow-xs hover:shadow-xl transition-all duration-300">
                                <div class="slide--cat-entry__img w-full h-16 sm:h-20 flex items-center justify-center mb-2.5 overflow-hidden">
                                    {% if cat_img %}
                                        <img src="{{ cat_img }}" class="max-h-full max-w-full object-contain transform group-hover:scale-110 transition-transform duration-300 drop-shadow-sm" width="64" height="64" alt="{{ cat.name }}" loading="lazy"/>
                                    {% elseif cat.icon %}
                                        <div class="w-12 h-12 rounded-xl bg-slate-100 group-hover:bg-slate-800 text-slate-800 group-hover:text-amber-400 flex items-center justify-center text-2xl transform group-hover:scale-110 transition-all duration-300">
                                            <i class="{{ cat.icon }}"></i>
                                        </div>
                                    {% else %}
                                        <div class="w-12 h-12 rounded-xl bg-slate-100 group-hover:bg-slate-800 text-slate-800 group-hover:text-amber-400 flex items-center justify-center text-2xl transform group-hover:scale-110 transition-all duration-300">
                                            <i class="sicon-car"></i>
                                        </div>
                                    {% endif %}
                                </div>
                                <h2 class="text-xs sm:text-sm font-black text-slate-900 group-hover:text-white transition-colors duration-300 truncate">
                                    {{ cat.name }}
                                </h2>
                            </a>
                        </div>
                    {% endfor %}
                {% else %}
                    {# Custom Merchant Links Mode (with PNG image support & zoom animation) #}
                    {% for link in component.links %}
                        {% if link.title %}
                            {% set link_img = link.image.url|default(link.image) %}
                            <div class="swiper-slide slide--one-sixth">
                                <a href="{{ link.url }}" class="slide--cat-entry group block text-center p-3.5 sm:p-4 rounded-2xl bg-white hover:bg-slate-900 border border-slate-200/85 hover:border-slate-800 shadow-xs hover:shadow-xl transition-all duration-300">
                                    <div class="slide--cat-entry__img w-full h-16 sm:h-20 flex items-center justify-center mb-2.5 overflow-hidden">
                                        {% if link_img %}
                                            <img src="{{ link_img }}" class="max-h-full max-w-full object-contain transform group-hover:scale-110 transition-transform duration-300 drop-shadow-sm" width="64" height="64" alt="{{ link.title }}" loading="lazy"/>
                                        {% elseif link.icon %}
                                            <div class="w-12 h-12 rounded-xl bg-slate-100 group-hover:bg-slate-800 text-slate-800 group-hover:text-amber-400 flex items-center justify-center text-2xl transform group-hover:scale-110 transition-all duration-300">
                                                <i class="{{ link.icon }}"></i>
                                            </div>
                                        {% else %}
                                            <div class="w-12 h-12 rounded-xl bg-slate-100 group-hover:bg-slate-800 text-slate-800 group-hover:text-amber-400 flex items-center justify-center text-2xl transform group-hover:scale-110 transition-all duration-300">
                                                <i class="sicon-car"></i>
                                            </div>
                                        {% endif %}
                                    </div>
                                    <h2 class="text-xs sm:text-sm font-black text-slate-900 group-hover:text-white transition-colors duration-300 truncate">
                                        {{ link.title }}
                                    </h2>
                                </a>
                            </div>
                        {% endif %}
                    {% endfor %}
                {% endif %}
            </div>
        </salla-slider>
    </div>
</section>
