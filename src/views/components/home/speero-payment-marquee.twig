{#
|--------------------------------------------------------------------------
| DORA CARS: Luxury Frameless Grayscale-to-Color Payment & Installment Marquee
|--------------------------------------------------------------------------
| Features:
| 1. Pure Frameless Floating Logos (No borders, no outer frames, no text below)
| 2. Elegant Grayscale in normal state -> Full Radiant Vibrant Color + Glowing Aura on Hover
| 3. Interactive Floating Tooltip with description on hover
| 4. Compact, seamless zero-gap continuous infinite ticker
|--------------------------------------------------------------------------
#}

{% set bg_color = component.bg_color|default(component.settings.bg_color)|default('#0b192c') %}
{% set title_text = component.title|default(component.settings.title)|default('طرق دفع آمنة 100% وتقسيط ميسر بدون فوائد') %}
{% set accent_col = component.accent_color|default(component.settings.accent_color)|default('#38bdf8') %}

<section
    class="speero-payment-marquee relative overflow-hidden"
    data-component="speero-payment-marquee"
    aria-label="طرق الدفع والتقسيط المعتمدة"
    style="background-color: {{ bg_color }};"
>
    <div class="speero-container max-w-7xl mx-auto px-4">
        
        {# Clean Compact Header #}
        {% if title_text %}
            <div class="flex items-center justify-center sm:justify-start gap-2 mb-2 px-1 text-center sm:text-right">
                <svg class="w-4 h-4 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                    <line x1="2" y1="10" x2="22" y2="10"></line>
                </svg>
                <span class="text-xs sm:text-sm font-black tracking-tight" style="color: {{ accent_col }};">
                    {{ title_text }}
                </span>
            </div>
        {% endif %}

        {# Seamless Continuous Infinite Ticker #}
        <div class="speero-payment-marquee__viewport">
            
            {# Track 1 #}
            <div class="speero-payment-marquee__track">
                {% if component.payment_methods and component.payment_methods|length > 0 %}
                    {% for item in component.payment_methods %}
                        {% set pay_name = item.name|default(item['payment_methods.name'])|default(item.title)|default('وسيلة دفع') %}
                        {% set pay_img = item.icon.url|default(item.icon)|default(item['payment_methods.icon'])|default(item.image.url)|default(item.image) %}
                        {% set pay_desc = item.description|default(item['payment_methods.description'])|default(item.sub_title)|default('دفع إلكتروني آمن ومطابق للشريعة') %}
                        
                        <div class="dora-payment-item" title="{{ pay_name }}">
                            {# Interactive Floating Tooltip #}
                            <div class="dora-payment-tooltip">
                                <span class="block font-black text-cyan-300">{{ pay_name }}</span>
                                <span class="block text-[10px] text-slate-300 font-normal mt-0.5">{{ pay_desc }}</span>
                            </div>

                            {% if pay_img %}
                                <img src="{{ pay_img }}" alt="{{ pay_name }}" loading="lazy" />
                            {% else %}
                                <i class="sicon-credit-card text-2xl text-cyan-400"></i>
                            {% endif %}
                        </div>
                    {% endfor %}
                {% else %}
                    {# Default High-Quality Authentic Payment Methods #}
                    {% set default_payments = [
                        {'name': 'مدى Mada', 'desc': 'دفع فوري عبر بطاقات مدى السعودية وبدون رسوم إضافية', 'icon': 'https://cdn.salla.sa/ZrBEO/MopzhoqpTkDObcKc8Q8n77AuydanfsGXdZO7iinH.jpg'},
                        {'name': 'أبل باي Apple Pay', 'desc': 'دفع فوري بلمسة واحدة عبر الآيفون وأجهزة Apple', 'icon': 'https://cdn.salla.sa/ZrBEO/3gOhYSaIhaHxhH2IHWxJYDl9JHwxP6dGKiZFSq4K.jpg'},
                        {'name': 'تمارا Tamara', 'desc': 'قسّم فاتورتك على 3 أو 4 دفعات بدون أي فوائد أو رسوم', 'icon': 'https://cdn.salla.sa/ZrBEO/3gOhYSaIhaHxhH2IHWxJYDl9JHwxP6dGKiZFSq4K.jpg'},
                        {'name': 'تابي Tabby', 'desc': 'قسّم مشترياتك على 4 دفعات شهرية ميسرة بدون فوائد', 'icon': 'https://cdn.salla.sa/ZrBEO/MopzhoqpTkDObcKc8Q8n77AuydanfsGXdZO7iinH.jpg'},
                        {'name': 'فيزا Visa', 'desc': 'بطاقات الائتمان والخصم المباشر فيزا العالمية', 'icon': 'https://cdn.salla.sa/ZrBEO/MopzhoqpTkDObcKc8Q8n77AuydanfsGXdZO7iinH.jpg'},
                        {'name': 'ماستركارد Mastercard', 'desc': 'دفع آمن ومحمي بكلمة سر ثلاثية الأمان 3D Secure', 'icon': 'https://cdn.salla.sa/ZrBEO/3gOhYSaIhaHxhH2IHWxJYDl9JHwxP6dGKiZFSq4K.jpg'}
                    ] %}
                    {% for p in default_payments %}
                        <div class="dora-payment-item" title="{{ p.name }}">
                            <div class="dora-payment-tooltip">
                                <span class="block font-black text-cyan-300">{{ p.name }}</span>
                                <span class="block text-[10px] text-slate-300 font-normal mt-0.5">{{ p.desc }}</span>
                            </div>
                            <img src="{{ p.icon }}" alt="{{ p.name }}" loading="lazy" />
                        </div>
                    {% endfor %}
                {% endif %}
            </div>

            {# Track 2 (Clone for 100% Seamless Infinite Continuous Loop) #}
            <div class="speero-payment-marquee__track" aria-hidden="true">
                {% if component.payment_methods and component.payment_methods|length > 0 %}
                    {% for item in component.payment_methods %}
                        {% set pay_name = item.name|default(item['payment_methods.name'])|default(item.title)|default('وسيلة دفع') %}
                        {% set pay_img = item.icon.url|default(item.icon)|default(item['payment_methods.icon'])|default(item.image.url)|default(item.image) %}
                        {% set pay_desc = item.description|default(item['payment_methods.description'])|default(item.sub_title)|default('دفع إلكتروني آمن ومطابق للشريعة') %}
                        
                        <div class="dora-payment-item" title="{{ pay_name }}">
                            <div class="dora-payment-tooltip">
                                <span class="block font-black text-cyan-300">{{ pay_name }}</span>
                                <span class="block text-[10px] text-slate-300 font-normal mt-0.5">{{ pay_desc }}</span>
                            </div>
                            {% if pay_img %}
                                <img src="{{ pay_img }}" alt="{{ pay_name }}" loading="lazy" />
                            {% else %}
                                <i class="sicon-credit-card text-2xl text-cyan-400"></i>
                            {% endif %}
                        </div>
                    {% endfor %}
                {% else %}
                    {% for p in default_payments %}
                        <div class="dora-payment-item" title="{{ p.name }}">
                            <div class="dora-payment-tooltip">
                                <span class="block font-black text-cyan-300">{{ p.name }}</span>
                                <span class="block text-[10px] text-slate-300 font-normal mt-0.5">{{ p.desc }}</span>
                            </div>
                            <img src="{{ p.icon }}" alt="{{ p.name }}" loading="lazy" />
                        </div>
                    {% endfor %}
                {% endif %}
            </div>

        </div>

    </div>
</section>
