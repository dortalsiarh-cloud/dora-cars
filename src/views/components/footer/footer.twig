{#
|--------------------------------------------------------------------------
| Speero Luxury Automotive Store Footer
|--------------------------------------------------------------------------
| Deep Navy Luxury Styling, 3 Organized Feature Columns, Verified Saudi Badges & Instant Customer Care
|--------------------------------------------------------------------------
#}

<footer data-testid="store-footer" class="store-footer relative bg-[#061527] text-white border-t border-slate-800 overflow-hidden mt-12 sm:mt-16">
    
    {# Ambient Glow Highlights #}
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl pointer-events-none"></div>

    <div aria-label="footer" class="store-footer__inner relative z-10 py-12 lg:py-16 border-b border-slate-800/80">
        <div class="container max-w-7xl mx-auto px-4 sm:px-6">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-10">
                
                {# ========================================================= #}
                {# COLUMN 1 (5 Cols): Store Identity, Bio & Official Badges #}
                {# ========================================================= #}
                <div class="lg:col-span-5 flex flex-col gap-4 text-right">
                    
                    {# Logo & Brand Name #}
                    <a href="{{ link('/') }}" class="inline-flex items-center gap-3 no-underline group">
                        <img src="{{ store.logo|cdn(180) }}" alt="{{ store.name }}" class="h-12 w-auto object-contain drop-shadow" loading="lazy" />
                        <div>
                            <h3 class="text-xl sm:text-2xl font-black text-white group-hover:text-amber-300 transition-colors m-0 leading-tight">
                                {{ store.name }}
                            </h3>
                            <span class="text-xs text-amber-400 font-bold block mt-0.5">قطع غيار أصلية ومضمونة 100%</span>
                        </div>
                    </a>

                    {# Store Description #}
                    {% if store.description %}
                        <div class="text-xs sm:text-sm text-slate-300 leading-relaxed font-normal max-w-md opacity-90">
                            {{ store.description|raw }}
                        </div>
                    {% else %}
                        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed font-normal max-w-md opacity-90">
                            المتجر المعتمد الأول لقطع غيار هيونداي وكيا (أصلي وكوري) متخصصون في الديزل وكافة القطع الاستهلاكية بأفضل الأسعار مع شحن فوري لكافة مدن المملكة.
                        </p>
                    {% endif %}

                    {# Saudi Commercial Register & Tax Badges #}
                    <div class="flex flex-wrap items-center gap-2.5 pt-2">
                        {# Commercial Register (السجل التجاري) #}
                        <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-900/90 border border-slate-700/80 shadow-inner">
                            <i class="sicon-award-ribbon text-amber-400 text-base"></i>
                            <div class="text-right">
                                <span class="text-[10px] text-slate-400 block font-medium">السجل التجاري</span>
                                <span class="text-xs font-bold text-white tracking-wider font-mono">7016475555</span>
                            </div>
                        </div>

                        {# Tax Number (الرقم الضريبي) #}
                        {% if store.settings.tax.number %}
                            <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-900/90 border border-slate-700/80 shadow-inner">
                                <i class="sicon-shield text-emerald-400 text-base"></i>
                                <div class="text-right">
                                    <span class="text-[10px] text-slate-400 block font-medium">الرقم الضريبي</span>
                                    <span class="text-xs font-bold text-white tracking-wider font-mono">{{ store.settings.tax.number }}</span>
                                </div>
                            </div>
                        {% endif %}

                        {# Salla Trust Badges #}
                        <div class="flex items-center">
                            <salla-trust-badges data-testid="store-footer-trust-badges" dark></salla-trust-badges>
                        </div>
                    </div>

                    {# Social Media Icons #}
                    <div class="pt-2">
                        <salla-social data-testid="store-footer-social" class="flex items-center gap-2"></salla-social>
                    </div>

                </div>

                {# ========================================================= #}
                {# COLUMN 2 (3 Cols): Important Pages & Quick Links          #}
                {# ========================================================= #}
                <div class="lg:col-span-3 text-right">
                    <div class="flex items-center gap-2 mb-4 pb-2 border-b border-slate-800">
                        <div class="w-2 h-5 rounded-full bg-amber-400"></div>
                        <h4 class="text-sm sm:text-base font-bold text-white m-0">روابط مهمة ومعلومات</h4>
                    </div>
                    
                    <div class="store-footer-menu-wrapper">
                        <salla-menu data-testid="store-footer-menu" source="footer" with-cookie-preferences></salla-menu>
                    </div>
                </div>

                {# ========================================================= #}
                {# COLUMN 3 (4 Cols): Customer Service & Direct Contacts     #}
                {# ========================================================= #}
                <div class="lg:col-span-4 text-right">
                    <div class="flex items-center gap-2 mb-4 pb-2 border-b border-slate-800">
                        <div class="w-2 h-5 rounded-full bg-blue-400"></div>
                        <h4 class="text-sm sm:text-base font-bold text-white m-0">خدمة العملاء والدعم الفني</h4>
                    </div>

                    <p class="text-xs text-slate-400 mb-3 leading-relaxed">
                        فريقنا الفني جاهز للإجابة على استفساراتكم ومطابقة قطع الغيار برقم الهيكل طوال أيام الأسبوع:
                    </p>

                    <div class="space-y-2">
                        <salla-contacts data-testid="store-footer-contacts" class="block"></salla-contacts>
                    </div>
                </div>

            </div>
        </div>
    </div>

    {# ========================================================= #}
    {# SUB-FOOTER: Copyright Notice & Payment Method Badges      #}
    {# ========================================================= #}
    <div class="relative z-10 py-5 bg-slate-950/90 border-t border-slate-800">
        <div class="container max-w-7xl mx-auto px-4 sm:px-6 flex flex-col md:flex-row items-center justify-between gap-4 text-center md:text-right">
            
            <div class="text-xs text-slate-400 font-medium leading-normal flex items-center justify-center gap-1.5 flex-wrap">
                <span>{% hook copyright %}</span>
                <span class="opacity-60">•</span>
                <span class="text-amber-400/90 font-bold">متخصصون في قطع غيار هيونداي وكيا</span>
            </div>

            <div class="flex items-center justify-center">
                <salla-payments data-testid="store-footer-payments"></salla-payments>
            </div>

        </div>
    </div>

</footer>
