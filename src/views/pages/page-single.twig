{#
| Variable     | Type                  | Description |
|--------------|-----------------------|-------------|
| page         | Page                  |             |
| page.title   | string                |             |
| page.content | string                |             |
| page.url     | string                |             |
| page.slug    | string                |             |
| page.type    | string                |             |
#}
{% extends "layouts.master" %}

{% block content %}
    {% set wa_number = store.contacts.whatsapp|default(store.contacts.phone|default('966500000000'))|replace({'+': '', ' ': '', '-': ''}) %}

    {% if page.type == 'customised' %}
      {# Hook for customised builder pages #}
      <div class="s-blocks-wrapper s-information-page !mt-0">{% hook 'information_page.information_page' %}</div>
    {% else %}

      {# 1. DORA LUXURY INFORMATIVE PAGE HERO BANNER #}
      <div class="dora-page-hero py-8 sm:py-12 text-white">
          <div class="container mx-auto px-4 max-w-5xl">
              
              {# Breadcrumbs Navigation #}
              <nav class="breadcrumbs w-full mb-3 text-xs opacity-80">
                  <salla-breadcrumb></salla-breadcrumb>
              </nav>

              <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                  <div>
                      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/15 border border-cyan-400/30 text-cyan-300 text-xs font-bold mb-2.5">
                          <span>🛡️</span>
                          <span>اللوائح والسياسات الرسمية المعتمدة</span>
                      </div>
                      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-white tracking-tight">
                          {{ page.title }}
                      </h1>
                  </div>

                  {# Trust Badge #}
                  <div class="flex items-center gap-2 text-xs text-slate-300">
                      <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-white/5 border border-white/10">
                          <span class="text-emerald-400 font-black">✓</span>
                          <span>متجر درة السيارة المعتمد</span>
                      </span>
                  </div>
              </div>

          </div>
      </div>

      {# 2. PAGE CONTENT BODY CONTAINER #}
      <div class="container mx-auto px-4 py-8 sm:py-12">
          <div class="max-w-4xl mx-auto">
              
              {# Main White Reading Card #}
              <div class="dora-page-card p-6 sm:p-10 mb-8">
                  <div class="dora-page-body content-entry">
                      {{ page.content|raw }}
                  </div>
              </div>

              {# Comments (if enabled on page) #}
              <salla-comments data-testid="store-page-comments" item-id="{{ page.id }}" type="page"></salla-comments>

              {# 3. DIRECT VIP CUSTOMER SUPPORT CARD #}
              <div class="dora-cat-help-card mt-8">
                  <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-right">
                      <div>
                          <h4 class="text-base sm:text-lg font-black text-white mb-1">
                              هل لديك أي استفسار بخصوص هذه السياسة أو المنتجات؟
                          </h4>
                          <p class="text-xs sm:text-sm text-slate-300 font-normal">
                              فريق خدمة عملاء درة السيارة متواجد دائماً لمساعدتك وتقديم الدعم الفوري.
                          </p>
                      </div>
                      <a
                          href="https://wa.me/{{ wa_number }}?text={{ ('السلام عليكم، أود الاستفسار بخصوص صفحة: ' ~ page.title ~ ' عبر متجر درة السيارة')|url_encode }}"
                          target="_blank"
                          rel="noopener noreferrer"
                          class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-black text-xs sm:text-sm transition flex items-center gap-2 shrink-0 shadow-lg no-underline"
                      >
                          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                          </svg>
                          <span>تواصل مع خدمة العملاء</span>
                      </a>
                  </div>
              </div>

          </div>
      </div>

    {% endif %}
{% endblock %}
