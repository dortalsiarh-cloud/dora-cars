{#
|--------------------------------------------------------------------------
| Speero Continuous Infinite Payment & Installment Marquee
|--------------------------------------------------------------------------
| Salla Twilight Component: home.speero-payment-marquee
| Features Frameless Large Icons on Top, Subtle Titles Below, & Infinite Continuous TV-style Ticker
|--------------------------------------------------------------------------
#}

{% set bg_color = component.bg_color|default(component.settings.bg_color)|default('#0b192c') %}
{% set title_text = component.title|default(component.settings.title)|default('طرق دفع آمنة 100% وتقسيط ميسر بدون فوائد') %}
{% set accent_col = component.accent_color|default(component.settings.accent_color)|default('#f59e0b') %}

<section
    class="speero-payment-marquee relative overflow-hidden py-4 sm:py-5 border-y border-white/10"
    data-component="speero-payment-marquee"
    aria-label="طرق الدفع والتقسيط المعتمدة"
    style="background-color: {{ bg_color }};"
>
    <div class="speero-container max-w-7xl mx-auto px-4">
        
        {# Clean Header #}
        {% if title_text %}
            <div class="flex items-center gap-2 mb-3.5 px-1">
                <svg class="w-4 h-4 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                    <line x1="2" y1="10" x2="22" y2="10"></line>
                </svg>
                <span class="text-xs sm:text-sm font-bold text-slate-200 tracking-tight" style="color: {{ accent_col }};">
                    {{ title_text }}
                </span>
            </div>
        {% endif %}

        {# Seamless Continuous Infinite Ticker #}
        <div class="speero-payment-marquee__viewport">
            
            {# Track 1 #}
            <div class="speero-payment-marquee__track">
                {% if component.payment_methods and component.payment_methods|length > 0 %}
                    {% for item in component.payment_methods %}
                        {% set pay_name = item.name|default(item['payment_methods.name'])|default(item.title)|default('وسيلة دفع') %}
                        {% set pay_img = item.icon.url|default(item.icon)|default(item['payment_methods.icon'])|default(item.image.url)|default(item.image) %}
                        {% set pay_desc = item.description|default(item['payment_methods.description'])|default(item.sub_title) %}
                        
                        <div class="group flex flex-col items-center justify-center p-2.5 sm:p-3 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 hover:border-amber-400/40 transition-all duration-300 min-w-[95px] sm:min-w-[110px] shrink-0 text-center cursor-pointer shadow-sm hover:shadow-md hover:-translate-y-0.5">
                            <div class="h-8 sm:h-9 flex items-center justify-center mb-1.5">
                                {% if pay_img %}
                                    <img src="{{ pay_img }}" alt="{{ pay_name }}" loading="lazy" class="h-7 sm:h-8 w-auto max-w-[85px] object-contain drop-shadow group-hover:scale-110 transition-transform duration-300" />
                                {% else %}
                                    <i class="sicon-credit-card text-2xl text-amber-400 group-hover:scale-110 transition-transform"></i>
                                {% endif %}
                            </div>
                            <span class="text-[10px] sm:text-[11px] font-bold text-slate-300 group-hover:text-amber-300 transition-colors whitespace-nowrap">
                                {{ pay_name }}
                            </span>
                        </div>
                    {% endfor %}
                {% else %}
                    {# Default High-Quality Authentic Payment Methods #}
                    {% set default_payments = [
                        {'name': 'مدى Mada', 'icon': 'https://cdn.salla.sa/ZrBEO/MopzhoqpTkDObcKc8Q8n77AuydanfsGXdZO7iinH.jpg'},
                        {'name': 'أبل باي Apple Pay', 'icon': 'https://cdn.salla.sa/ZrBEO/3gOhYSaIhaHxhH2IHWxJYDl9JHwxP6dGKiZFSq4K.jpg'},
                        {'name': 'تابي Tabby', 'icon': 'https://cdn.salla.sa/ZrBEO/MopzhoqpTkDObcKc8Q8n77AuydanfsGXdZO7iinH.jpg'},
                        {'name': 'تمارا Tamara', 'icon': 'https://cdn.salla.sa/ZrBEO/3gOhYSaIhaHxhH2IHWxJYDl9JHwxP6dGKiZFSq4K.jpg'},
                        {'name': 'فيزا Visa', 'icon': 'https://cdn.salla.sa/ZrBEO/MopzhoqpTkDObcKc8Q8n77AuydanfsGXdZO7iinH.jpg'},
                        {'name': 'ماستركارد Mastercard', 'icon': 'https://cdn.salla.sa/ZrBEO/3gOhYSaIhaHxhH2IHWxJYDl9JHwxP6dGKiZFSq4K.jpg'}
                    ] %}
                    {% for p in default_payments %}
                        <div class="group flex flex-col items-center justify-center p-2.5 sm:p-3 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 hover:border-amber-400/40 transition-all duration-300 min-w-[95px] sm:min-w-[110px] shrink-0 text-center cursor-pointer shadow-sm hover:shadow-md hover:-translate-y-0.5">
                            <div class="h-8 sm:h-9 flex items-center justify-center mb-1.5">
                                <i class="sicon-credit-card text-2xl text-amber-400 group-hover:scale-110 transition-transform"></i>
                            </div>
                            <span class="text-[10px] sm:text-[11px] font-bold text-slate-300 group-hover:text-amber-300 transition-colors whitespace-nowrap">
                                {{ p.name }}
                            </span>
                        </div>
                    {% endfor %}
                {% endif %}
            </div>

            {# Track 2 (Clone for 100% Seamless Infinite Continuous Loop) #}
            <div class="speero-payment-marquee__track" aria-hidden="true">
                {% if component.payment_methods and component.payment_methods|length > 0 %}
                    {% for item in component.payment_methods %}
                        {% set pay_name = item.name|default(item['payment_methods.name'])|default(item.title)|default('وسيلة دفع') %}
                        {% set pay_img = item.icon.url|default(item.icon)|default(item['payment_methods.icon'])|default(item.image.url)|default(item.image) %}
                        {% set pay_desc = item.description|default(item['payment_methods.description'])|default(item.sub_title) %}
                        
                        <div class="group flex flex-col items-center justify-center p-2.5 sm:p-3 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 hover:border-amber-400/40 transition-all duration-300 min-w-[95px] sm:min-w-[110px] shrink-0 text-center cursor-pointer shadow-sm hover:shadow-md hover:-translate-y-0.5">
                            <div class="h-8 sm:h-9 flex items-center justify-center mb-1.5">
                                {% if pay_img %}
                                    <img src="{{ pay_img }}" alt="{{ pay_name }}" loading="lazy" class="h-7 sm:h-8 w-auto max-w-[85px] object-contain drop-shadow group-hover:scale-110 transition-transform duration-300" />
                                {% else %}
                                    <i class="sicon-credit-card text-2xl text-amber-400 group-hover:scale-110 transition-transform"></i>
                                {% endif %}
                            </div>
                            <span class="text-[10px] sm:text-[11px] font-bold text-slate-300 group-hover:text-amber-300 transition-colors whitespace-nowrap">
                                {{ pay_name }}
                            </span>
                        </div>
                    {% endfor %}
                {% else %}
                    {% for p in default_payments %}
                        <div class="group flex flex-col items-center justify-center p-2.5 sm:p-3 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 hover:border-amber-400/40 transition-all duration-300 min-w-[95px] sm:min-w-[110px] shrink-0 text-center cursor-pointer shadow-sm hover:shadow-md hover:-translate-y-0.5">
                            <div class="h-8 sm:h-9 flex items-center justify-center mb-1.5">
                                <i class="sicon-credit-card text-2xl text-amber-400 group-hover:scale-110 transition-transform"></i>
                            </div>
                            <span class="text-[10px] sm:text-[11px] font-bold text-slate-300 group-hover:text-amber-300 transition-colors whitespace-nowrap">
                                {{ p.name }}
                            </span>
                        </div>
                    {% endfor %}
                {% endif %}
            </div>

        </div>

    </div>
</section>
