{#
| Variable                  | Type    | Description                                   |
|---------------------------|---------|-----------------------------------------------|
| component.store_title     | string  | Store Name / Main Heading                     |
| component.title_color     | string  | Title Golden/Primary Color                    |
| component.store_specialty | string  | Store Specialty / Top Badge                   |
| component.store_slogan    | string  | Store Slogan & Value Proposition              |
| component.bg_desktop      | string  | Background image for Desktop                  |
| component.bg_mobile       | string  | Background image for Mobile                   |
| component.bg_opacity      | number  | Background overlay opacity (0 to 100%)        |
| component.font_family     | string  | Selected font family                          |
| component.btn_text        | string  | Primary CTA Button Text                       |
| component.btn_url         | string  | Primary CTA Button URL                        |
| component.shipping_url    | string  | Shipping page URL                             |
| component.guarantee_url   | string  | Guarantee & Reviews page URL                  |
| component.returns_url     | string  | Returns page URL                              |
| component.support_url     | string  | Support page URL or modal trigger             |
| component.inquiry_brands  | string  | Car brands list for inquiry modal             |
| component.hyundai_phone   | string  | Hyundai specialist WhatsApp number            |
| component.kia_phone       | string  | Kia specialist WhatsApp number                |
| component.general_phone   | string  | General support WhatsApp number               |
#}

{% set unique_id = 'store-hero-' ~ random(1000, 9999) %}
{% set modal_id = 'modal-support-' ~ random(1000, 9999) %}
{% set store_title = component.store_title|default(store.name) %}
{% set title_color = component.title_color|default('#f59e0b') %}
{% set specialty = component.store_specialty|default('المتجر المعتمد الأول لقطع الغيار ومستلزمات السيارات') %}
{% set slogan = component.store_slogan|default('نوفر لك تشكيلة متكاملة من أجود قطع الغيار والمنتجات الأصلية والمضمونة بأفضل الأسعار وبخدمة شحن وتوصيل فوري لباب بيتك مع ضمان ذهبي.') %}
{% set bg_desktop = component.bg_desktop %}
{% set bg_mobile = component.bg_mobile|default(bg_desktop) %}
{% set opacity_val = (component.bg_opacity is not null and component.bg_opacity != '') ? (component.bg_opacity / 100) : 0.20 %}
{% set font_choice = component.font_family is iterable ? component.font_family|first.value|default('cairo') : component.font_family|default('cairo') %}
{% set btn_text = component.btn_text|default('تصفح كافة الأقسام والمنتجات') %}
{% set btn_url = component.btn_url|default('/categories') %}

{% set shipping_url = component.shipping_url|default('/shipping-policy') %}
{% set guarantee_url = component.guarantee_url|default('/guarantee-reviews') %}
{% set returns_url = component.returns_url|default('/return-policy') %}
{% set support_url = component.support_url %}

{% set inquiry_brands_raw = component.inquiry_brands|default("هيونداي (Hyundai)\nكيا (Kia)\nتويوتا (Toyota)\nنيسان (Nissan)\nفورد (Ford)\nشانجان (Changan)\nجيلي (Geely)\nهوندا (Honda)\nشيفروليه (Chevrolet)\nماركة أخرى") %}
{% set brand_list = inquiry_brands_raw|split("\n") %}

{% set hyundai_phone = component.hyundai_phone|default(store.contacts.whatsapp|default(store.contacts.phone|default('966500000000')))|replace({'+': '', ' ': '', '-': ''}) %}
{% set kia_phone = component.kia_phone|default(store.contacts.whatsapp|default(store.contacts.phone|default('966500000000')))|replace({'+': '', ' ': '', '-': ''}) %}
{% set general_phone = component.general_phone|default(store.contacts.whatsapp|default(store.contacts.phone|default('966500000000')))|replace({'+': '', ' ': '', '-': ''}) %}

<section class="store-identity-hero-section my-4 sm:my-6 overflow-hidden" id="{{ unique_id }}">
    {# Google Fonts Dynamic Loader #}
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Almarai:wght@400;700;800&family=Cairo:wght@400;600;700;800;900&family=IBM+Plex+Sans+Arabic:wght@400;600;700&family=Tajawal:wght@400;500;700;800;900&display=swap');

        #{{ unique_id }} {
            {% if font_choice == 'cairo' %}
                font-family: 'Cairo', sans-serif !important;
            {% elseif font_choice == 'tajawal' %}
                font-family: 'Tajawal', sans-serif !important;
            {% elseif font_choice == 'ibm' %}
                font-family: 'IBM Plex Sans Arabic', sans-serif !important;
            {% elseif font_choice == 'almarai' %}
                font-family: 'Almarai', sans-serif !important;
            {% endif %}
        }

        #{{ unique_id }} .hero-bg-layer {
            {% if bg_desktop %}
                background-image: url('{{ bg_desktop }}');
            {% endif %}
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
        }

        @media (max-width: 768px) {
            #{{ unique_id }} .hero-bg-layer {
                {% if bg_mobile %}
                    background-image: url('{{ bg_mobile }}');
                {% elseif bg_desktop %}
                    background-image: url('{{ bg_desktop }}');
                {% endif %}
            }
        }
    </style>

    <div class="container">
        <div class="store-identity-card relative rounded-2xl overflow-hidden text-white p-6 sm:p-10 lg:p-12 shadow-2xl border border-slate-800 bg-slate-950">
            
            {# 1. Background Image Layer #}
            {% if bg_desktop or bg_mobile %}
                <div class="hero-bg-layer absolute inset-0 z-0 opacity-100"></div>
            {% endif %}

            {# 2. Controllable Darkness / Opacity Overlay #}
            <div class="absolute inset-0 z-0 bg-slate-950 transition-opacity duration-300" style="opacity: {{ opacity_val }};"></div>
            
            {# 3. Subtle Ambient Highlights #}
            <div class="absolute -top-20 -right-20 w-72 h-72 bg-red-600/15 rounded-full blur-3xl pointer-events-none"></div>
            <div class="absolute -bottom-20 -left-20 w-72 h-72 bg-amber-500/15 rounded-full blur-3xl pointer-events-none"></div>

            {# 4. Hero Content #}
            <div class="relative z-10 max-w-4xl mx-auto text-center flex flex-col items-center gap-4 sm:gap-6">
                
                {# Specialty Tag #}
                {% if specialty %}
                    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-slate-900/80 backdrop-blur-md border border-white/20 text-xs sm:text-sm font-bold shadow-sm" style="color: {{ title_color }};">
                        <i class="sicon-award-ribbon text-base"></i>
                        <span>{{ specialty }}</span>
                    </div>
                {% endif %}

                {# Store Title with Dynamic Color Gradient #}
                <h2 class="text-2xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white leading-tight drop-shadow-md">
                    <span style="background: linear-gradient(135deg, {{ title_color }} 0%, #ffffff 50%, {{ title_color }} 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">{{ store_title }}</span>
                </h2>

                {# Slogan & Bio #}
                {% if slogan %}
                    <p class="text-sm sm:text-base lg:text-lg text-slate-200 leading-relaxed font-medium max-w-2xl drop-shadow-sm">
                        {{ slogan }}
                    </p>
                {% endif %}

                {# Action Button #}
                {% if btn_text %}
                    <div class="mt-1">
                        <a href="{{ btn_url }}" class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl text-slate-950 font-extrabold text-sm sm:text-base transition duration-300 shadow-lg hover:brightness-110 hover:-translate-y-0.5" style="background-color: {{ title_color }};">
                            <i class="sicon-shopping-bag text-lg"></i>
                            <span>{{ btn_text }}</span>
                        </a>
                    </div>
                {% endif %}

                {# Trust 4 Vertical Cards with Icons on Top and Single Line Text #}
                <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 w-full mt-6 pt-6 border-t border-white/15">
                    
                    {# 1. Shipping & Fast Delivery (Red Truck) #}
                    <a href="{{ shipping_url }}" class="group flex flex-col items-center justify-center text-center p-3.5 sm:p-4 rounded-xl bg-slate-900/60 hover:bg-slate-800/90 backdrop-blur-md border border-white/10 hover:border-red-500/50 hover:-translate-y-1 transition-all duration-300 shadow-sm hover:shadow-lg">
                        <div class="w-11 h-11 rounded-xl bg-red-500/15 flex items-center justify-center text-red-400 group-hover:scale-110 transition duration-300 mb-2.5 shrink-0 shadow-inner">
                            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                                <path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
                            </svg>
                        </div>
                        <h4 class="text-xs sm:text-sm font-bold text-white group-hover:text-red-400 transition leading-tight whitespace-nowrap">
                            شحن وتوصيل فوري
                        </h4>
                        <p class="text-[10px] sm:text-xs text-slate-300 mt-1 whitespace-nowrap truncate">تغطية شاملة وسريعة</p>
                    </a>

                    {# 2. 100% Guaranteed Original & Reviews (Gold Shield) #}
                    <a href="{{ guarantee_url }}" class="group flex flex-col items-center justify-center text-center p-3.5 sm:p-4 rounded-xl bg-slate-900/60 hover:bg-slate-800/90 backdrop-blur-md border border-white/10 hover:border-amber-500/50 hover:-translate-y-1 transition-all duration-300 shadow-sm hover:shadow-lg">
                        <div class="w-11 h-11 rounded-xl bg-amber-500/15 flex items-center justify-center text-amber-400 group-hover:scale-110 transition duration-300 mb-2.5 shrink-0 shadow-inner">
                            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                                <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
                            </svg>
                        </div>
                        <h4 class="text-xs sm:text-sm font-bold text-white group-hover:text-amber-400 transition leading-tight whitespace-nowrap">
                            أصلي ومضمون 100%
                        </h4>
                        <p class="text-[10px] sm:text-xs text-slate-300 mt-1 whitespace-nowrap truncate">جودة وفحص وتقييمات</p>
                    </a>

                    {# 3. Flexible Returns & Exchange (Blue Circular Reload Arrows) #}
                    <a href="{{ returns_url }}" class="group flex flex-col items-center justify-center text-center p-3.5 sm:p-4 rounded-xl bg-slate-900/60 hover:bg-slate-800/90 backdrop-blur-md border border-white/10 hover:border-blue-500/50 hover:-translate-y-1 transition-all duration-300 shadow-sm hover:shadow-lg">
                        <div class="w-11 h-11 rounded-xl bg-blue-500/15 flex items-center justify-center text-blue-400 group-hover:scale-110 transition duration-300 mb-2.5 shrink-0 shadow-inner">
                            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                                <path d="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 15.03 20 13.57 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74C4.46 8.97 4 10.43 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z"/>
                            </svg>
                        </div>
                        <h4 class="text-xs sm:text-sm font-bold text-white group-hover:text-blue-400 transition leading-tight whitespace-nowrap">
                            إرجاع واستبدال مرن
                        </h4>
                        <p class="text-[10px] sm:text-xs text-slate-300 mt-1 whitespace-nowrap truncate">سياسة ميسرة وسهلة</p>
                    </a>

                    {# 4. Smart WhatsApp Technical Support & Car Parts Request (Green WhatsApp Icon) #}
                    {% if support_url %}
                        <a href="{{ support_url }}" class="group flex flex-col items-center justify-center text-center p-3.5 sm:p-4 rounded-xl bg-slate-900/60 hover:bg-slate-800/90 backdrop-blur-md border border-white/10 hover:border-emerald-500/50 hover:-translate-y-1 transition-all duration-300 shadow-sm hover:shadow-lg">
                            <div class="w-11 h-11 rounded-xl bg-emerald-500/15 flex items-center justify-center text-emerald-400 group-hover:scale-110 transition duration-300 mb-2.5 shrink-0 shadow-inner">
                                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                                    <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm0 18.12c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.125 8.125 0 0 1-1.25-4.35c0-4.52 3.68-8.2 8.2-8.2 2.19 0 4.25.85 5.8 2.4 1.55 1.55 2.4 3.61 2.4 5.8 0 4.52-3.68 8.21-8.16 8.21zm4.49-6.16c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43s-.56-1.34-.76-1.84c-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.53.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.07-.1-.22-.16-.47-.28z"/>
                                </svg>
                            </div>
                            <h4 class="text-xs sm:text-sm font-bold text-white group-hover:text-emerald-400 transition leading-tight whitespace-nowrap">
                                طلب قطعة ودعم فني
                            </h4>
                            <p class="text-[10px] sm:text-xs text-slate-300 mt-1 whitespace-nowrap truncate">استشارات عبر واتساب</p>
                        </a>
                    {% else %}
                        <button type="button" onclick="document.getElementById('{{ modal_id }}').classList.remove('hidden')" class="group flex flex-col items-center justify-center text-center p-3.5 sm:p-4 rounded-xl bg-slate-900/60 hover:bg-slate-800/90 backdrop-blur-md border border-white/10 hover:border-emerald-500/50 hover:-translate-y-1 transition-all duration-300 shadow-sm hover:shadow-lg cursor-pointer">
                            <div class="w-11 h-11 rounded-xl bg-emerald-500/15 flex items-center justify-center text-emerald-400 group-hover:scale-110 transition duration-300 mb-2.5 shrink-0 shadow-inner">
                                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                                    <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm0 18.12c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.125 8.125 0 0 1-1.25-4.35c0-4.52 3.68-8.2 8.2-8.2 2.19 0 4.25.85 5.8 2.4 1.55 1.55 2.4 3.61 2.4 5.8 0 4.52-3.68 8.21-8.16 8.21zm4.49-6.16c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43s-.56-1.34-.76-1.84c-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.53.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.07-.1-.22-.16-.47-.28z"/>
                                </svg>
                            </div>
                            <h4 class="text-xs sm:text-sm font-bold text-white group-hover:text-emerald-400 transition leading-tight whitespace-nowrap">
                                طلب قطعة ودعم فني
                            </h4>
                            <p class="text-[10px] sm:text-xs text-slate-300 mt-1 whitespace-nowrap truncate">توجيه واستشارة فورية</p>
                        </button>
                    {% endif %}

                </div>

            </div>
        </div>
    </div>

    {# 5. Smart Parts & Technical Support Modal #}
    <div id="{{ modal_id }}" class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 bg-slate-950/80 backdrop-blur-md hidden transition-all duration-300">
        <div class="relative w-full max-w-lg bg-slate-900 text-white rounded-2xl border border-slate-800 shadow-2xl overflow-hidden animate-fadeIn">
            
            {# Modal Header #}
            <div class="p-4 sm:p-5 bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 border-b border-slate-700/60 flex items-center justify-between">
                <div class="flex items-center gap-2.5">
                    <div class="w-9 h-9 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-lg">
                        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm0 18.12c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.125 8.125 0 0 1-1.25-4.35c0-4.52 3.68-8.2 8.2-8.2 2.19 0 4.25.85 5.8 2.4 1.55 1.55 2.4 3.61 2.4 5.8 0 4.52-3.68 8.21-8.16 8.21zm4.49-6.16c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43s-.56-1.34-.76-1.84c-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.53.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.07-.1-.22-.16-.47-.28z"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="text-base sm:text-lg font-bold text-white leading-tight">طلب تسعير واستفسار قطع الغيار</h3>
                        <p class="text-xs text-slate-400">تحويل مباشر لمسؤول العلامة التجارية عبر واتساب</p>
                    </div>
                </div>
                <button type="button" onclick="document.getElementById('{{ modal_id }}').classList.add('hidden')" class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white flex items-center justify-center text-lg transition">
                    <i class="sicon-cancel"></i>
                </button>
            </div>

            {# Modal Body / Interactive Smart Form #}
            <form id="form-{{ modal_id }}" onsubmit="submitSmartSupportForm(event, '{{ modal_id }}', '{{ hyundai_phone }}', '{{ kia_phone }}', '{{ general_phone }}')" class="p-4 sm:p-6 space-y-3.5 text-right">
                
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    {# Customer Name #}
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-1">الاسم الكريم <span class="text-red-400">*</span></label>
                        <input type="text" name="customer_name" required placeholder="مثال: محمد عبدالله" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-800 border border-slate-700 text-white text-xs sm:text-sm focus:border-amber-400 focus:outline-none transition">
                    </div>

                    {# Customer Phone #}
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-1">رقم الجوال للتواصل <span class="text-red-400">*</span></label>
                        <input type="tel" name="customer_phone" required placeholder="مثال: 05xxxxxxxx" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-800 border border-slate-700 text-white text-xs sm:text-sm focus:border-amber-400 focus:outline-none transition">
                    </div>
                </div>

                {# Car Brand Selector (Dynamic Department Router) #}
                <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1">العلامة التجارية للسيارة (القسم المختص) <span class="text-red-400">*</span></label>
                    <select name="car_brand" required onchange="updateDepartmentBadge(this, '{{ modal_id }}')" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-800 border border-slate-700 text-white text-xs sm:text-sm focus:border-amber-400 focus:outline-none transition cursor-pointer">
                        <option value="" disabled selected>اختر نوع وماركة السيارة...</option>
                        {% for b in brand_list %}
                            {% set b_clean = b|trim %}
                            {% if b_clean %}
                                <option value="{{ b_clean }}">{{ b_clean }}</option>
                            {% endif %}
                        {% endfor %}
                    </select>
                </div>

                {# Dynamic Router Notice Badge #}
                <div id="dept-notice-{{ modal_id }}" class="p-2.5 rounded-xl bg-slate-800/80 border border-slate-700 text-xs text-slate-300 flex items-center gap-2">
                    <i class="sicon-chat-bubble-dots text-amber-400 text-base shrink-0"></i>
                    <span id="dept-text-{{ modal_id }}">اختر الماركة لتحديد مسؤول القسم ورقم الواتساب المتخصص</span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    {# Model & Year #}
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-1">موديل وسنة الصنع <span class="text-red-400">*</span></label>
                        <input type="text" name="car_model" required placeholder="مثال: سوناتا 2023 / سبورتاج 2021" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-800 border border-slate-700 text-white text-xs sm:text-sm focus:border-amber-400 focus:outline-none transition">
                    </div>

                    {# VIN / Chassis Number #}
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-1">رقم الهيكل (VIN) <span class="text-slate-400 text-[10px]">(17 حرف بالاستمارة)</span></label>
                        <input type="text" name="car_vin" placeholder="مثال: KMHD84LF..." maxlength="17" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-800 border border-slate-700 text-white text-xs sm:text-sm focus:border-amber-400 focus:outline-none transition uppercase tracking-wider">
                    </div>
                </div>

                {# Part Details #}
                <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1">القطع المطلوبة أو الاستفسار <span class="text-red-400">*</span></label>
                    <textarea name="part_details" required rows="2" placeholder="اكتب اسم القطعة (مثال: أقمشة فرامل أمامية، مساعدات، شمعة يمين...)" class="w-full px-3.5 py-2 rounded-xl bg-slate-800 border border-slate-700 text-white text-xs sm:text-sm focus:border-amber-400 focus:outline-none transition"></textarea>
                </div>

                {# Submit Button #}
                <div class="pt-2">
                    <button type="submit" class="w-full py-3.5 rounded-xl bg-gradient-to-r from-emerald-500 to-green-600 hover:from-emerald-600 hover:to-green-700 text-white font-black text-sm sm:text-base flex items-center justify-center gap-2 transition duration-300 shadow-lg hover:shadow-green-500/20 cursor-pointer">
                        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm0 18.12c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.125 8.125 0 0 1-1.25-4.35c0-4.52 3.68-8.2 8.2-8.2 2.19 0 4.25.85 5.8 2.4 1.55 1.55 2.4 3.61 2.4 5.8 0 4.52-3.68 8.21-8.16 8.21zm4.49-6.16c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43s-.56-1.34-.76-1.84c-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.53.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.07-.1-.22-.16-.47-.28z"/>
                        </svg>
                        <span>إرسال الطلب فوراً للمتخصص عبر واتساب</span>
                    </button>
                </div>

            </form>
        </div>
    </div>

</section>

{# Smart Modal JavaScript Engine #}
<script>
    function updateDepartmentBadge(selectElem, modalId) {
        var brand = selectElem.value;
        var noticeBox = document.getElementById('dept-notice-' + modalId);
        var noticeText = document.getElementById('dept-text-' + modalId);
        
        if (brand.indexOf('هيونداي') !== -1) {
            noticeBox.className = 'p-2.5 rounded-xl bg-blue-950/60 border border-blue-600/40 text-xs text-blue-200 flex items-center gap-2';
            noticeText.innerHTML = '🚗 تم تحديد <b>قسم مبيعات واستشارات هيونداي (Hyundai Specialist)</b>';
        } else if (brand.indexOf('كيا') !== -1) {
            noticeBox.className = 'p-2.5 rounded-xl bg-red-950/60 border border-red-600/40 text-xs text-red-200 flex items-center gap-2';
            noticeText.innerHTML = '🚙 تم تحديد <b>قسم مبيعات واستشارات كيا (Kia Specialist)</b>';
        } else {
            noticeBox.className = 'p-2.5 rounded-xl bg-slate-800 border border-slate-700 text-xs text-slate-300 flex items-center gap-2';
            noticeText.innerHTML = '🔧 تم تحديد <b>قسم المبيعات والاستشارات الفنية العامة</b>';
        }
    }

    function submitSmartSupportForm(e, modalId, hyundaiPhone, kiaPhone, generalPhone) {
        e.preventDefault();
        var form = document.getElementById('form-' + modalId);
        var name = form.customer_name.value.trim();
        var phone = form.customer_phone.value.trim();
        var brand = form.car_brand.value;
        var model = form.car_model.value.trim();
        var vin = form.car_vin.value.trim();
        var details = form.part_details.value.trim();

        var targetPhone = generalPhone;
        var deptName = "المبيعات العامة";

        if (brand.indexOf('هيونداي') !== -1 && hyundaiPhone) {
            targetPhone = hyundaiPhone;
            deptName = "قسم هيونداي المتخصص";
        } else if (brand.indexOf('كيا') !== -1 && kiaPhone) {
            targetPhone = kiaPhone;
            deptName = "قسم كيا المتخصص";
        }

        var message = "👋 مرحباً، أرغب في الاستفسار وطلب تسعير قطع غيار عبر المتجر:\n\n" +
                      "👤 *الاسم:* " + name + "\n" +
                      "📱 *الجوال:* " + phone + "\n" +
                      "🏷️ *العلامة التجارية:* " + brand + " (" + deptName + ")\n" +
                      "🚗 *الموديل وسنة الصنع:* " + model + "\n" +
                      (vin ? ("🔢 *رقم الهيكل (VIN):* " + vin + "\n") : "") +
                      "📝 *القطع المطلوبة:* " + details + "\n\n" +
                      "⚡ تم الإرسال عبر النموذج الذكي في المتجر.";

        var waUrl = "https://api.whatsapp.com/send?phone=" + targetPhone + "&text=" + encodeURIComponent(message);
        window.open(waUrl, '_blank');
        document.getElementById(modalId).classList.add('hidden');
    }
</script>
