        'mitsubishi': ['باجيرو', 'لانسر', 'L200', 'اوتلاندر', 'اكليبس كروس', 'اتراج', 'مونتيرو سبورت', 'ASX']
    };

    function parseCustomModels() {
        var raw = `{{ custom_models_raw|raw }}`;
        var map = {};
        if (!raw || !raw.trim()) return map;
        var lines = raw.split('\n');
        lines.forEach(function(l) {
            var parts = l.split(':');
            if (parts.length >= 2) {
                var brand = parts[0].trim().toLowerCase();
                var models = parts[1].split(',').map(function(m) { return m.trim(); }).filter(Boolean);
                if (brand && models.length) {
                    map[brand] = models;
                }
            }
        });
        return map;
    }

    function normalizeText(str) {
        return (str || '').toLowerCase()
            .replace(/[()\/\\-_]/g, ' ')
            .replace(/أ|إ|آ/g, 'ا')
            .replace(/ة/g, 'ه')
            .replace(/ى/g, 'ي')
            .trim();
    }

    function onMakeChange(makeSelect, modelSelectId) {
        var rawMake = makeSelect.value;
        var modelSelect = document.getElementById(modelSelectId);
        if (!modelSelect) return;
        modelSelect.innerHTML = '';

        if (!rawMake) {
            modelSelect.innerHTML = '<option value="">-- كافة الموديلات --</option>';
            return;
        }

        var customMap = parseCustomModels();
        var normalizedMake = normalizeText(rawMake);
        var modelsFound = null;

        // Check custom map first
        Object.keys(customMap).forEach(function(k) {
            if (normalizedMake.indexOf(normalizeText(k)) !== -1 || normalizeText(k).indexOf(normalizedMake) !== -1) {
                modelsFound = customMap[k];
            }
        });

        // Fallback to built-in database
        if (!modelsFound) {
            Object.keys(defaultCarModelsData).forEach(function(k) {
                if (normalizedMake.indexOf(normalizeText(k)) !== -1 || normalizeText(k).indexOf(normalizedMake) !== -1) {
                    modelsFound = defaultCarModelsData[k];
                }
            });
        }

        if (modelsFound && modelsFound.length) {
            modelSelect.innerHTML = '<option value="">-- كافة موديلات ' + rawMake.split(' ')[0] + ' --</option>';
            modelsFound.forEach(function(m) {
                var opt = document.createElement('option');
                opt.value = m;
                opt.textContent = m;
                modelSelect.appendChild(opt);
            });
        } else {
            modelSelect.innerHTML = '<option value="">-- كافة الموديلات --</option>';
        }
    }

    function openSpeeroModal(modalId, tabName) {
        var modal = document.getElementById(modalId);
        if (modal) {
            modal.classList.remove('hidden');
            switchSpeeroModalTab(modalId, tabName);

            // Trigger auto model population if make is already chosen
            var makeSelect = document.getElementById('modal-make-' + modalId);
            if (makeSelect && makeSelect.value) {
                onMakeChange(makeSelect, 'modal-model-' + modalId);
            }
        }
    }

    function closeSpeeroModal(modalId) {
        var modal = document.getElementById(modalId);
        if (modal) {
            modal.classList.add('hidden');
        }
    }

    function switchSpeeroModalTab(modalId, tabName) {
        var tabs = ['vehicle', 'vin', 'oem'];
        tabs.forEach(function(t) {
            var pane = document.getElementById('pane-' + modalId + '-' + t);
            var btn = document.getElementById('tab-btn-' + modalId + '-' + t);
            if (pane && btn) {
                if (t === tabName) {
                    pane.classList.remove('hidden');
                    btn.className = 'flex-1 py-2.5 px-3 rounded-xl transition flex items-center justify-center gap-1.5 cursor-pointer bg-slate-800 text-amber-300 border border-slate-700';
                } else {
                    pane.classList.add('hidden');
                    btn.className = 'flex-1 py-2.5 px-3 rounded-xl transition flex items-center justify-center gap-1.5 cursor-pointer text-slate-400 hover:text-white';
                }
            }
        });
    }

    function submitVehicleFilter(modalId, searchUrl) {
        var make = document.getElementById('modal-make-' + modalId).value;
        var model = document.getElementById('modal-model-' + modalId).value;
        var year = document.getElementById('modal-year-' + modalId).value;
        var cat = document.getElementById('modal-cat-' + modalId).value;

        var query = [];
        if (make) {
            var cleanMake = make.replace(/\(.*?\)/g, '').trim();
            query.push(cleanMake);
        }
        if (model) query.push(model);
        if (year) query.push(year);
        if (cat) query.push(cat);

        var keyword = query.join(' ');
        if (!keyword) keyword = 'قطع غيار';
        
        var base = searchUrl || '/products';
        var separator = base.indexOf('?') !== -1 ? '&' : '?';
        window.location.href = base + separator + 'keyword=' + encodeURIComponent(keyword);
    }

    function submitOemSearch(modalId, searchUrl) {
        var oem = document.getElementById('oem-input-' + modalId).value.trim();
        if (oem) {
            var base = searchUrl || '/products';
            var separator = base.indexOf('?') !== -1 ? '&' : '?';
            window.location.href = base + separator + 'keyword=' + encodeURIComponent(oem);
        }
    }

    function submitModalVinQuote(e, modalId, waPhone) {
        e.preventDefault();
        var name = document.getElementById('vin-name-' + modalId).value.trim();
        var phone = document.getElementById('vin-phone-' + modalId).value.trim();
        var car = document.getElementById('vin-car-' + modalId).value.trim();
        var vin = document.getElementById('vin-code-' + modalId).value.trim();
        var details = document.getElementById('vin-details-' + modalId).value.trim();

        var whatsappNumber = waPhone || '966500000000';

        var message = "👋 مرحباً، أود الاستفسار وطلب تسعير قطع غيار:\n\n" +
                      "👤 *الاسم:* " + name + "\n" +
                      "📱 *الجوال:* " + phone + "\n" +
                      "🚗 *السيارة والموديل:* " + car + "\n" +
                      (vin ? ("🔢 *رقم الهيكل (VIN):* " + vin + "\n") : "") +
                      "📝 *القطع المطلوبة:* " + details + "\n\n" +
                      "⚡ تم الإرسال عبر محرك البحث الذكي في المتجر.";

        var whatsappUrl = "https://api.whatsapp.com/send?phone=" + whatsappNumber + "&text=" + encodeURIComponent(message);
        
        closeSpeeroModal(modalId);
        window.open(whatsappUrl, '_blank');
    }
</script>
